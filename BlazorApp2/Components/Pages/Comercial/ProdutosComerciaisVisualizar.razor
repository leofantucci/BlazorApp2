@page "/produtos-comerciais/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]
@using Microsoft.EntityFrameworkCore
@using Repositorio
@using TechToysDominio
@inject IDbContextFactory<MyDBContext> ContextFactory

<PageTitle>Produtos comerciais - Gestão Infinity</PageTitle>
<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Produtos comerciais da loja</p></div>
    <div class="d-flex flex-wrap gap-2 my-3">
        <a class="btn btn-primary" href="/produtos-comerciais/cadastrar">Cadastrar produto</a>
        <a class="btn btn-outline-secondary" href="/ecommerce">Voltar ao e-commerce</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(_erro)) { <div class="alert alert-danger">@_erro</div> }
    @if (_produtos.Count == 0) { <div class="alert alert-info">Nenhum produto comercial cadastrado.</div> }
    else
    {
        <div class="table-responsive"><table class="table table-striped table-bordered align-middle">
            <thead class="table-dark"><tr><th>Produto</th><th>Preço</th><th>Produto de fabricação</th><th>Exibição na loja</th><th>Ações</th></tr></thead>
            <tbody>@foreach (var produto in _produtos)
            {
                <tr @key="produto.Id">
                    <td><strong>@produto.Nome</strong><div class="small text-muted">Código #@produto.Id</div></td>
                    <td>@produto.Preco.ToString("C2", _br)</td>
                    <td>@(produto.ProdutoBase?.Nome ?? "Não vinculado")</td>
                    <td><span class="badge @(produto.Disponivel ? "bg-success" : "bg-secondary")">@(produto.Disponivel ? "Publicado" : "Oculto")</span></td>
                    <td class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-primary" href="/produtos-comerciais/editar/@produto.Id">Editar</a><a class="btn btn-sm btn-outline-danger" href="/produtos-comerciais/remover/@produto.Id">Remover</a></td>
                </tr>
            }</tbody>
        </table></div>
    }
</div>
@code {
    private readonly System.Globalization.CultureInfo _br = new("pt-BR");
    private List<ProdutoComercial> _produtos = new();
    private string? _erro;
    protected override async Task OnInitializedAsync()
    {
        try { await using var db = await ContextFactory.CreateDbContextAsync(); _produtos = await db.ProdutoComercial.AsNoTracking().Include(p => p.ProdutoBase).OrderBy(p => p.Nome).ToListAsync(); }
        catch { _erro = "Não foi possível carregar os produtos comerciais."; }
    }
}
