@page "/produtos-comerciais/editar/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Repositorio
@using TechToysDominio
@inject IDbContextFactory<MyDBContext> ContextFactory
@inject NavigationManager Navigation
<PageTitle>Editar produto comercial</PageTitle>
<div class="centralizado"><div class="faixaNinja corSecundaria"><p>Editar produto comercial</p></div>
@if (_naoEncontrado) { <div class="alert alert-warning mt-3">Produto não encontrado.</div> }
else if (_carregando) { <p class="mt-3">Carregando...</p> }
else { @if (!string.IsNullOrWhiteSpace(_erro)) { <div class="alert alert-danger mt-3">@_erro</div> }
<div class="card p-3 mt-3"><EditForm Model="_form" OnValidSubmit="SalvarAsync" FormName="ProdutoComercialEditar"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3">
<div class="col-md-6"><label class="form-label">Nome *</label><InputText class="form-control" @bind-Value="_form.Nome"/></div><div class="col-md-3"><label class="form-label">Preço (R$) *</label><InputNumber class="form-control" @bind-Value="_form.Preco"/></div>
<div class="col-md-3"><label class="form-label">Produto de fabricação</label><InputSelect class="form-select" @bind-Value="_form.ProdutoBaseId"><option value="">Sem vínculo</option>@foreach (var p in _bases) { <option value="@p.Id">#@p.Id - @p.Nome</option> }</InputSelect></div>
<div class="col-12"><label class="form-label">URL da imagem</label><InputText class="form-control" @bind-Value="_form.Foto"/></div><div class="col-12"><label class="form-label">Descrição</label><InputTextArea class="form-control" @bind-Value="_form.Descricao"/></div><div class="col-12 form-check ms-2"><InputCheckbox class="form-check-input" @bind-Value="_form.Disponivel"/><label class="form-check-label">Publicado na loja</label></div></div>
<div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit" disabled="@_salvando">Salvar alterações</button><a class="btn btn-secondary" href="/produtos-comerciais/visualizar">Cancelar</a></div></EditForm></div> }
</div>
@code {
    [Parameter] public int Id { get; set; }
    private sealed class Formulario { [Required, StringLength(100)] public string Nome { get; set; } = ""; [Range(0.01, 99999999, ErrorMessage = "O preço deve ser igual ou superior a R$ 0,01.")] public decimal Preco { get; set; } [StringLength(500)] public string Foto { get; set; } = ""; [StringLength(2000)] public string? Descricao { get; set; } public int? ProdutoBaseId { get; set; } public bool Disponivel { get; set; } }
    private Formulario _form = new(); private List<Produto> _bases = new(); private bool _carregando = true, _naoEncontrado, _salvando; private string? _erro;
    protected override async Task OnInitializedAsync() { await using var db = await ContextFactory.CreateDbContextAsync(); var p = await db.ProdutoComercial.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id); _bases = await db.Produto.AsNoTracking().OrderBy(x => x.Nome).ToListAsync(); if (p is null) _naoEncontrado = true; else _form = new() { Nome = p.Nome, Preco = p.Preco, Foto = p.Foto, Descricao = p.Descricao, ProdutoBaseId = p.ProdutoBaseId, Disponivel = p.Disponivel }; _carregando = false; }
    private async Task SalvarAsync() { if (_salvando) return; _salvando = true; try { await using var db = await ContextFactory.CreateDbContextAsync(); var p = await db.ProdutoComercial.FirstOrDefaultAsync(x => x.Id == Id) ?? throw new InvalidOperationException("Produto não encontrado."); if (_form.ProdutoBaseId.HasValue && !await db.Produto.AnyAsync(x => x.Id == _form.ProdutoBaseId.Value)) throw new InvalidOperationException("Produto de fabricação inválido."); p.Nome = _form.Nome.Trim(); p.Preco = _form.Preco; p.Foto = _form.Foto.Trim(); p.Descricao = _form.Descricao?.Trim(); p.ProdutoBaseId = _form.ProdutoBaseId; p.Disponivel = _form.Disponivel; p.DataAtualizacaoUtc = DateTime.UtcNow; await db.SaveChangesAsync(); Navigation.NavigateTo("/produtos-comerciais/visualizar"); } catch (Exception ex) { _erro = $"Não foi possível salvar: {ex.Message}"; } finally { _salvando = false; } }
}
