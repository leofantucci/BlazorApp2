@page "/produtos-comerciais/remover/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]
@using Microsoft.EntityFrameworkCore
@using Repositorio
@using TechToysDominio
@inject IDbContextFactory<MyDBContext> ContextFactory
@inject NavigationManager Navigation
<PageTitle>Remover produto comercial</PageTitle>
<div class="centralizado"><div class="faixaNinja corSecundaria"><p>Remover produto comercial</p></div>
@if (_carregando) { <p class="mt-3">Carregando...</p> }
else if (_produto is null) { <div class="alert alert-warning mt-3">Produto não encontrado.</div> }
else { <div class="card p-3 mt-3"><h4>@_produto.Nome</h4><p>Preço: @_produto.Preco.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</p><p>Esta ação retira o produto da loja pública. O registro é preservado para manter o histórico de pedidos.</p>@if (!string.IsNullOrWhiteSpace(_erro)) { <div class="alert alert-danger">@_erro</div> }<div class="d-flex gap-2"><button class="btn btn-danger" @onclick="RemoverAsync" disabled="@_removendo">@( _removendo ? "Removendo..." : "Confirmar remoção")</button><a class="btn btn-secondary" href="/produtos-comerciais/visualizar">Cancelar</a></div></div> }
</div>
@code {
    [Parameter] public int Id { get; set; } private ProdutoComercial? _produto; private bool _carregando = true, _removendo; private string? _erro;
    protected override async Task OnInitializedAsync() { await using var db = await ContextFactory.CreateDbContextAsync(); _produto = await db.ProdutoComercial.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id); _carregando = false; }
    private async Task RemoverAsync() { if (_removendo || _produto is null) return; _removendo = true; try { await using var db = await ContextFactory.CreateDbContextAsync(); var p = await db.ProdutoComercial.FirstOrDefaultAsync(x => x.Id == Id) ?? throw new InvalidOperationException("Produto não encontrado."); p.Disponivel = false; p.DataAtualizacaoUtc = DateTime.UtcNow; await db.SaveChangesAsync(); Navigation.NavigateTo("/produtos-comerciais/visualizar"); } catch (Exception ex) { _erro = $"Não foi possível remover: {ex.Message}"; } finally { _removendo = false; } }
}
