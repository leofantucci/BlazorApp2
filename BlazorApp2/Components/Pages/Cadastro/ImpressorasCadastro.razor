@page "/impressoras/cadastrar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Impressoras - Cadastro</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Impressoras - Cadastro</p></div>
    
    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger">@mensagemErro</div>
    }

    <div class="blueprint blueprint-1">
        <p class="texto-padrao-1">Insira o NOME da impressora</p><br/>
        <input class="entrada" placeholder="Impressora Principal" @bind="nome" /><br/>

        <a class="texto-padrao-1">Insira o MODELO da impressora</a><br/>
        <input class="entrada" placeholder="Creality Ender 3v3" @bind="modelo" /><br/>

        <a class="texto-padrao-1">Insira o CUSTO da impressora (KW/h)</a><br/>
        <input class="entrada" type="number" step="0.01" placeholder="0.15" @bind="kwh" /><br/>
    </div>

    <!-- Botão aciona o método Salvar ao invés de navegar via href -->
    <button class="btn btn-personalizado corSecundaria" @onclick="Salvar">Cadastrar</button>
    <br/>
    <a class="btn btn-secondary" href="/impressoras">Voltar</a>
</div>

@code {
    private string nome = string.Empty;
    private string modelo = string.Empty;
    private double kwh = 0.15;
    private string mensagemErro = string.Empty;

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(nome) || string.IsNullOrWhiteSpace(modelo))
        {
            mensagemErro = "Por favor, preencha o Nome e o Modelo.";
            return;
        }

        try
        {
            // Chama a função já existente no repositório
            RepositorioTechToys.CadastrarImpressora(nome, modelo, kwh);

            // Redireciona para a lista ou tela inicial
            NavigationManager.NavigateTo("/impressoras");
        }
        catch (Exception ex)
        {
            // Pega a mensagem mais profunda (a causa raiz informada pelo PostgreSQL)
            var erroReal = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
            mensagemErro = $"Erro ao salvar: {erroReal}";
        }
    }
}