@page "/clientes/cadastrar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Clientes - Cadastro</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Clientes - Cadastro</p></div>
    
    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger">@mensagemErro</div>
    }

    <div class="blueprint blueprint-2">
        <p class="texto-padrao-1">Insira o NOME do cliente</p><br/>
        <input class="entrada" placeholder="Ash" @bind="nome" /><br/>
        <a class="texto-padrao-1">Insira o TELEFONE do cliente</a><br/>
        <input class="entrada" placeholder="+55 (11) 123456789" @bind="telefone" /><br/>
        <p class="texto-padrao-1">Insira o EMAIL do cliente</p><br/>
        <input class="entrada" placeholder="email@xyz.com" @bind="email" /><br/>
        <p class="texto-padrao-1">Insira o INSTAGRAM do cliente</p><br/>
        <input class="entrada" placeholder="@nome_insta" @bind="instagram" /><br/>

    </div>

    <!-- Botão aciona o método Salvar ao invés de navegar via href -->
    <button class="btn btn-personalizado corSecundaria" @onclick="Salvar">Cadastrar</button>
    <br/>
    <a class="btn btn-secondary" href="/clientes">Voltar</a>
</div>

@code {
    private string nome = string.Empty;
    private string email = string.Empty;
    private string telefone = string.Empty;
    private string instagram = string.Empty;
    private string nome_insta = "@charizard_333";
    
    private string mensagemErro = string.Empty;

    private void Salvar()
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            mensagemErro = "Por favor, preencha o Nome do cliente.";
            return;
        }

        try
        {
            RepositorioTechToys.CadastrarCliente(nome, telefone, email, instagram);

            NavigationManager.NavigateTo("/clientes");
        }
        catch (Exception ex)
        {
            // Exibe o erro exato na tela e também no console do Visual Studio / Terminal
            Console.WriteLine($"[ERRO CADASTRO]: {ex}");
    
            // Varre até achar a causa raiz real lançada pelo banco
            Exception erroAtual = ex;
            while (erroAtual.InnerException != null)
            {
                erroAtual = erroAtual.InnerException;
            }
    
            mensagemErro = $"Detalhe do erro: {erroAtual.Message}";
            StateHasChanged();
        }
    }
}