@page "/embalagens/cadastrar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Embalagens - Cadastro</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Embalagens - Cadastro</p></div>
    
    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger">@mensagemErro</div>
    }

    <div class="blueprint blueprint-2">
        <p class="texto-padrao-1">Insira o NOME da embalagem</p><br/>
        <input class="entrada" placeholder="Caixa grande" @bind="nome" /><br/>
        
        <p class="texto-padrao-1">Insira o TIPO de embalagem</p><br/>
        <input class="entrada" placeholder="Caixa/Sacola" @bind="tipo" /><br/>
        
        <div class="dimensoes">
            <div>
                <a class="texto-padrao-1">Insira a LARGURA do produto (mm)</a><br/>
                <input class="entrada" type="number" step="any" placeholder="135" @bind="largura"/><br/>
            </div>
            <div>
                <a class="texto-padrao-1">Insira o COMPRIMENTO do produto (mm)</a><br/>
                <input class="entrada" type="number" step="any" placeholder="175" @bind="comprimento"/><br/>
            </div>
            <div>
                <a class="texto-padrao-1">Insira a ALTURA do produto (mm)</a><br/>
                <input class="entrada" type="number" step="any" placeholder="200" @bind="altura"/><br/>
            </div>
        </div>
        
        <a class="texto-padrao-1">Insira o CUSTO de compra da embalagem (R$)</a><br/>
        <input class="entrada" type="number" step="0.01" placeholder="0.70" @bind="preco" /><br/>
        
        <a class="texto-padrao-1">Insira o ESTOQUE do produto</a><br/>
        <input class="entrada" type="number" placeholder="5" @bind="estoque" /><br/>
        
        <a class="texto-padrao-1">Insira o ID do FORNECEDOR da embalagem</a>
        <a class="atalho_visualizar" href="/fornecedores/visualizar" target="_blank">Visualizar Fornecedores</a>
        <input class="entrada" type="number" placeholder="10" @bind="idFornecedor" /><br/>
    </div>

    <button class="btn btn-personalizado corSecundaria" @onclick="Salvar">Cadastrar</button>
    <br/>
    <a class="btn btn-secondary" href="/embalagens">Voltar</a>
</div>

@code {
    private string nome = string.Empty;
    private string tipo = string.Empty;
    private double largura, comprimento, altura, preco;
    private int estoque, idFornecedor;
    
    private string mensagemErro = string.Empty;

    private void Salvar()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(nome))
        {
            mensagemErro = "Por favor, preencha o Nome da embalagem.";
            return;
        }

        if (idFornecedor <= 0)
        {
            mensagemErro = "Por favor, informe um ID de fornecedor válido.";
            return;
        }

        try
        {
            Fornecedor fornecedor = RepositorioTechToys.ObterPorId<Fornecedor>(idFornecedor);

            if (fornecedor == null)
            {
                mensagemErro = $"Fornecedor com ID {idFornecedor} não foi encontrado.";
                return;
            }

            RepositorioTechToys.CadastrarEmbalagem(nome, tipo, largura, comprimento, altura, preco, fornecedor, estoque);

            NavigationManager.NavigateTo("/embalagens");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERRO CADASTRO]: {ex}");

            Exception erroAtual = ex;
            while (erroAtual.InnerException != null)
            {
                erroAtual = erroAtual.InnerException;
            }

            mensagemErro = $"Detalhe do erro: {erroAtual.Message}";
            StateHasChanged();
        }
    }
}