@page "/placas"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Placas NFC</PageTitle>

<h1 class="faixaNinja">Placas NFC</h1>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
        @mensagem
    </div>
}

<div class="container-personalizado-2">
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('V')"> 
        <img class="foto-4" src="Media/cadastrar.webp" alt="Icone-Cadastrar"/>
        <span class="texto-padrao-1">Vender Placa</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('Q')"> 
        <img class="foto-4" src="Media/QrCode.webp" alt="Icone-QRCode"/>
        <span class="texto-padrao-1">QR Code</span>
    </div>
</div>

<!-- Área exclusiva para o botão Voltar, logo abaixo do bloco de cards -->
<div class="area-botoes">
    <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
</div>

@code {
    private string mensagem = string.Empty;
    private bool sucesso = true;

    private void funcao(char c)
    {
        if (c == 'V')
        {
            Navigation.NavigateTo("vendas/cadastrar/");
        }

        if (c == 'Q')
        {
            Navigation.NavigateTo("placas/qr/");
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}