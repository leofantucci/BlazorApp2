@page "/visao-geral/limpar-banco"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]

@using Microsoft.AspNetCore.Authorization
@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Visão-Geral - Limpar Banco</PageTitle>

<h1 class="faixaNinja">Visão-Geral - Limpar Banco</h1>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
        @mensagem
    </div>
}

<p class="texto-padrao-1">
    Esta ação remove os dados operacionais (vendas, produtos, estoque, clientes e fornecedores).
    Os usuários e o histórico de auditoria serão preservados.
</p>

<div class="container-personalizado-2">
    <div class="card-personalizado-2" style="cursor: pointer;" @onclick="LimparBanco">
        <img class="foto-2" src="Media/deletar.webp" alt="Icone-Deletar" />
        <span class="texto-padrao-1">Sim</span>
    </div>
    <div class="card-personalizado-2" style="cursor: pointer;" @onclick="Inicio">
        <img class="foto-2" src="Media/deletar.webp" alt="Icone-Cancelar" />
        <span class="texto-padrao-1">Não</span>
    </div>
</div>

<!-- Área exclusiva para o botão Voltar, logo abaixo do bloco de cards -->
<div class="area-botoes">
    <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
</div>

@code {
    private string mensagem = string.Empty;
    private bool sucesso = true;

    private async Task LimparBanco()
    {
        var confirmou = await JS.InvokeAsync<bool>(
            "confirm",
            "Confirma a limpeza dos dados operacionais? Usuários e auditoria serão preservados.");
        if (!confirmou) return;

        try
        {
            RepositorioTechToys.LimparBanco();
            sucesso = true;
            mensagem = "Todas as tabelas foram limpas com sucesso!";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Falha ao limpar dados operacionais: {ex}");
            sucesso = false;
            mensagem = "Não foi possível concluir a limpeza do banco. Consulte os registros do servidor.";
        }
    }

    private void Inicio()
    {
        Navigation.NavigateTo("/inicio");
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
