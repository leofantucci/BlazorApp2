@page "/ecommerce"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>E-Commerce</PageTitle>

<h1 class="faixaNinja">E-Commerce</h1>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
        @mensagem
    </div>
}

<div class="container-personalizado-2 placas-nfc-menu">
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('C')"> 
        <img class="foto-4" src="Media/dashboard.webp" alt="Icone-Dashboard"/>
        <span class="texto-padrao-1">Painel de Controle</span>
    </div>
    
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('P')"> 
        <img class="foto-4" src="Media/PlacaIcon.webp" alt="Icone-Placa"/>
        <span class="texto-padrao-1">Produtos Comerciais</span>
    </div>
    
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('V')"> 
        <img class="foto-4" src="Media/visualizar.webp" alt="Icone-Visualizar"/>
        <span class="texto-padrao-1">Ver Site</span>
    </div>
</div>

<!-- Área exclusiva para o botão Voltar, logo abaixo do bloco de cards -->
<div class="area-botoes">
    <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
</div>

@code {
    private string mensagem = string.Empty;
    private bool sucesso = true;

    private void funcao(char c)
    {
        if (c == 'V')
        {
            Navigation.NavigateTo("https://placas-infinity.onrender.com", forceLoad: true);
        }

        if (c == 'P')
        {
            Navigation.NavigateTo("/produtos-comerciais/visualizar");
        }
        
        if (c == 'C')
        {
            Navigation.NavigateTo("/painel-de-controle");
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("appNavigation.backOrFallback", "/visao-geral");
    }
}