@page "/fornecedores/editar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Fornecedores - Editar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Fornecedores - Editar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Site</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Email</td>
                        <td>@item.Telefone</td>
                        <td>@item.Site</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => Editar(item.Id)">
                                Editar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/fornecedores/cadastrar">Novo Fornecedor</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum fornecedor cadastrado no momento.</p>
        <a class="btn btn-primary" href="/fornecedores/cadastrar">Cadastrar Agora</a>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    public List<Fornecedor> lista = new List<Fornecedor>();

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            lista = RepositorioTechToys.ListarTodos<Fornecedor>() ?? new List<Fornecedor>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
    }

    private void Editar(int id) => NavigationManager.NavigateTo($"/fornecedores/editar/{id}");
    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}