@page "/pecas/editar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Peças 3D - Editar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Peças 3D - Editar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando peças...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead><tr><th>ID</th><th>Nome</th><th>Matérias-primas / cores</th><th>Impressora</th><th>Peso</th><th>Estoque</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var peca in lista)
            {
                <tr><td>@peca.Id</td><td>@peca.Nome</td><td>@(peca.MateriasPrimas.Count > 0 ? string.Join("; ", peca.MateriasPrimas.Select(m => $"{m.MateriaPrima.Nome}: {m.Peso:N3} g")) : (peca.Materia_Prima?.Nome ?? "Não informada"))</td><td>@(peca.Impressora?.Modelo ?? "Não informada")</td><td>@peca.Peso_Impressao.ToString("N3") g</td><td>@(RepositorioTechToys.ObterQuantidadeEstoque<Peca>(peca.Id).ToString("N0")) UN</td><td>@(peca.Ativo ? "Ativa" : "Inativa")</td></tr>
                <td>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => Editar(peca.Id)">
                        Editar
                    </button>
                </td>
            }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/pecas/cadastrar">Nova peça</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum peça cadastrado no momento.</p>
        <a class="btn btn-primary" href="/pecas/cadastrar">Cadastrar Agora</a>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    public List<Peca> lista = new List<Peca>();
    private bool carregando = true;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Peca>() ?? new List<Peca>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void Editar(int id) => NavigationManager.NavigateTo($"/pecas/editar/{id}");
    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}