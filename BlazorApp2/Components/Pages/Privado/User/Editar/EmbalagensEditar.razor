@page "/embalagens/editar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Embalagens - Editar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Embalagens - Editar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando embalagens...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Custo (R$)</th>
                    <th>Estoque</th>
                    <th>Fornecedor - Nome</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Tipo</td>
                        <td>(@item.largura, @item.comprimento, @item.altura)</td>
                        <td>@item.Preco.ToString("F2")</td>
                        <td>@(RepositorioTechToys.ObterQuantidadeEstoque<Embalagem>(item.Id))</td>
                        <td>@(item.Fornecedor?.Nome ?? "Nenhum")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => Editar(item.Id)">
                                Editar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/embalagens/cadastrar">Nova Embalagem</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma embalagem cadastrada no momento.</p>
        <a class="btn btn-primary" href="/embalagens/cadastrar">Cadastrar Agora</a>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    public List<Embalagem> lista = new List<Embalagem>();
    private bool carregando = true;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Embalagem>() ?? new List<Embalagem>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void Editar(int id) => NavigationManager.NavigateTo($"/embalagens/editar/{id}");
    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}