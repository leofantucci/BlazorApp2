@page "/produtos/editar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Produtos - Editar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Produtos - Editar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando produtos...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Valor de Venda (R$)</th>
                    <th>Estoque</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>(@item.largura, @item.comprimento, @item.altura)</td>
                        <td>R$ @item.Valor_Venda.ToString("F2")</td>
                        <td>@(RepositorioTechToys.ObterQuantidadeEstoque<Produto>(item.Id))</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => Editar(item.Id)">
                                Editar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/produtos/cadastrar">Novo Produto</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum produto cadastrado no momento.</p>
        <a class="btn btn-primary" href="/produtos/cadastrar">Cadastrar Agora</a>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    public List<Produto> lista = new List<Produto>();
    private bool carregando = true;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Produto>() ?? new List<Produto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void Editar(int id) => NavigationManager.NavigateTo($"/produtos/editar/{id}");
    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}