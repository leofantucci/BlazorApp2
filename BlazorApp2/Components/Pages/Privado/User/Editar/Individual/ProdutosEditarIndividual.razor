@page "/produtos/editar/{id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Produtos - Editar Produto</PageTitle>

<div class="centralizado pagina-formulario">
    <div class="faixaNinja corSecundaria"><p>Editar Produto</p></div>

    @if (produto != null)
    {
        <div class="blueprint blueprint-2 formulario-card form-edit-card">
            <div class="mb-3">
                <label class="form-label">Nome</label>
                <input class="form-control" @bind="produto.Nome" />
            </div>
            <div class="mb-3">
                <label class="form-label">Largura</label>
                <input class="form-control" type="number" @bind="produto.largura" />
            </div>
            <div class="mb-3">
                <label class="form-label">Comprimento</label>
                <input class="form-control" type="number" @bind="produto.comprimento" />
            </div>
            <div class="mb-3">
                <label class="form-label">Altura</label>
                <input class="form-control" type="number" @bind="produto.altura" />
            </div>
            <div class="mb-3">
                <label class="form-label">Valor de Venda (R$)</label>
                <input class="form-control" type="number" step="0.01" @bind="produto.Valor_Venda" />
            </div>
            <div class="mb-3 form-check">
                <input class="form-check-input" type="checkbox" @bind="produto.Ativo" />
                <label class="form-check-label">Ativo</label>
            </div>
            <button class="btn btn-primary" @onclick="Salvar">Salvar</button>
            <button class="btn btn-secondary" @onclick="Voltar">Cancelar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Produto não encontrado.</p>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Produto? produto;

    protected override void OnParametersSet()
    {
        produto = RepositorioTechToys.ListarTodos<Produto>()?.FirstOrDefault(p => p.Id == Id);
    }

    private void Salvar()
    {
        if (produto == null) return;
        RepositorioTechToys.Atualizar(produto); // ajuste conforme o método real
        NavigationManager.NavigateTo("/produtos/visualizar");
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}