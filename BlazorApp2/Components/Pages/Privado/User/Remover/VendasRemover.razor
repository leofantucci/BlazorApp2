@page "/vendas/remover"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Vendas - Remover</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Vendas - Remover</p></div>

    @if (!string.IsNullOrWhiteSpace(mensagemErro))
    {
        <div class="alert alert-danger" role="alert">@mensagemErro</div>
    }

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando vendas...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Data/Hora</th>
                    <th>Cliente - Nome</th>
                    <th>Produtos</th>
                    <th>Embalagens</th>
                    <th>Total (R$)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Data_Hora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.Cliente?.Nome ?? "Cliente não informado")</td>
                        <td>
                            @if (item.ItensVenda != null && item.ItensVenda.Count > 0)
                            {
                                @foreach (var prod in item.ItensVenda)
                                {
                                    <div><strong>@(prod.Quantidade)x</strong> @(prod.Produto?.Nome ?? "Produto não informado")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nenhum produto</span>
                            }
                        </td>
                        <td>
                            @if (item.EmbalagensVenda != null && item.EmbalagensVenda.Count > 0)
                            {
                                @foreach (var emb in item.EmbalagensVenda)
                                {
                                    <div><strong>@(emb.Quantidade)x</strong> @(emb.Embalagem?.Nome ?? "Embalagem não informada")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sem embalagem</span>
                            }
                        </td>
                        <td>R$ @item.Calcular_Lucro_Bruto().ToString("F2")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => PerguntarExclusao(item)">
                                Excluir
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma venda cadastrada no momento.</p>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@if (itemSelecionado != null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir a venda <strong>ID @itemSelecionado.Id</strong> de @itemSelecionado.Data_Hora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")?</p>
                    <p class="text-danger">Os produtos acabados e as embalagens retornarão ao estoque. A matéria-prima já consumida na fabricação não será estornada.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarExclusao">Sim, excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Venda> lista = new List<Venda>();
    private bool carregando = true;
    private Venda? itemSelecionado;
    private string mensagemErro = string.Empty;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Venda>() ?? new List<Venda>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void PerguntarExclusao(Venda item) => itemSelecionado = item;
    private void Cancelar() => itemSelecionado = null;

    private void ConfirmarExclusao()
    {
        if (itemSelecionado == null) return;
        mensagemErro = string.Empty;
        try
        {
            if (!RepositorioTechToys.CancelarVendaRestaurandoEstoque(itemSelecionado.Id))
                throw new InvalidOperationException("A venda não foi encontrada.");
            itemSelecionado = null;
            CarregarDados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Falha ao cancelar venda: {ex}");
            mensagemErro = ex is InvalidOperationException or ArgumentException
                ? ex.Message
                : "Não foi possível cancelar a venda. O estoque não foi alterado parcialmente; atualize e tente novamente.";
            itemSelecionado = null;
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}
