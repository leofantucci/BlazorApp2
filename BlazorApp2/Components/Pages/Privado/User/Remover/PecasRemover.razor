@page "/pecas/remover"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Peças 3D - Remover</PageTitle>

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Peças 3D - Remover</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando peças...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead><tr><th>ID</th><th>Nome</th><th>Matérias-primas / cores</th><th>Impressora</th><th>Peso</th><th>Estoque</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var peca in lista)
                {
                    <tr>
                        <td>@peca.Id</td><td>@peca.Nome</td><td>@(peca.MateriasPrimas.Count > 0 ? string.Join("; ", peca.MateriasPrimas.Select(m => $"{m.MateriaPrima.Nome}: {m.Peso:N3} g")) : (peca.Materia_Prima?.Nome ?? "Não informada"))</td><td>@(peca.Impressora?.Modelo ?? "Não informada")</td><td>@peca.Peso_Impressao.ToString("N3") g</td><td>@(RepositorioTechToys.ObterQuantidadeEstoque<Peca>(peca.Id).ToString("N0")) UN</td><td>@(peca.Ativo ? "Ativa" : "Inativa")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => PerguntarExclusao(peca)">
                                Excluir
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma peça cadastrado no momento.</p>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@if (itemSelecionado != null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir a peça <strong>@itemSelecionado.Nome</strong> (ID @itemSelecionado.Id)?</p>
                    <p class="text-danger">Essa ação não pode ser desfeita.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarExclusao">Sim, excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Peca> lista = new List<Peca>();
    private bool carregando = true;
    private string mensagemErro = string.Empty;
    private Peca? itemSelecionado;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Peca>() ?? new List<Peca>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void PerguntarExclusao(Peca item) => itemSelecionado = item;
    private void Cancelar() => itemSelecionado = null;

    private void ConfirmarExclusao()
    {
        if (itemSelecionado == null) return;
        mensagemErro = string.Empty;
        try
        {
            RepositorioTechToys.DeletarPorId<Peca>(itemSelecionado.Id);
            itemSelecionado = null;
            CarregarDados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao excluir: {ex}");
            mensagemErro = ex is InvalidOperationException
                ? ex.Message
                : "Não foi possível excluir. Verifique se o registro possui vínculos ou dados relacionados.";
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}