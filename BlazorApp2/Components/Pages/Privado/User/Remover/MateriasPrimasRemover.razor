@page "/materias-primas/remover"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Materias-Primas - Remover</PageTitle>

@if (!string.IsNullOrWhiteSpace(mensagemErro))
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Materias-Primas - Remover</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando materias-primas...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Preço(R$)/grama</th>
                    <th>Fornecedor - Nome</th>
                    <th>Estoque - Qtd. (g)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>R$ @item.Calcular_Preco_Grama().ToString("F2")</td>
                        <td>@(item.Fornecedor?.Nome ?? "Nenhum")</td>
                        <td>@(RepositorioTechToys.ObterQuantidadeEstoque<MateriaPrima>(item.Id)) g</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => PerguntarExclusao(item)">
                                Excluir
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma materia prima cadastrada no momento.</p>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@if (itemSelecionado != null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir a matéria-prima <strong>@itemSelecionado.Nome</strong> (ID @itemSelecionado.Id)?</p>
                    <p class="text-danger">Essa ação não pode ser desfeita.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarExclusao">Sim, excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<MateriaPrima> lista = new List<MateriaPrima>();
    private bool carregando = true;
    private string mensagemErro = string.Empty;
    private MateriaPrima? itemSelecionado;

    protected override void OnInitialized() => CarregarDados();
    protected override void OnParametersSet() => CarregarDados();

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<MateriaPrima>() ?? new List<MateriaPrima>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private void PerguntarExclusao(MateriaPrima item) => itemSelecionado = item;
    private void Cancelar() => itemSelecionado = null;

    private void ConfirmarExclusao()
    {
        if (itemSelecionado == null) return;
        mensagemErro = string.Empty;
        try
        {
            RepositorioTechToys.DeletarPorId<MateriaPrima>(itemSelecionado.Id);
            itemSelecionado = null;
            CarregarDados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao excluir: {ex}");
            mensagemErro = ex is InvalidOperationException
                ? ex.Message
                : "Não foi possível excluir. Verifique se o registro possui vínculos ou dados relacionados.";
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}