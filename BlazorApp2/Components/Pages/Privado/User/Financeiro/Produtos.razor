@page "/financeiro/produtos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject IJSRuntime JS

<PageTitle>Financeiro - Produtos</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Análise de Custos por Produto</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Calculando custos dos produtos...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Custo MP</th>
                    <th>Custo Energia</th>
                    <th>Custo Total</th>
                    <th>Venda</th>
                    <th>Lucro Unit.</th>
                    <th>Margem</th>
                    <th>Estoque</th>
                    <th>Valor do Estoque</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in lista)
                {
                    var custoMp = p.Calcular_Custo_Materia_Prima();
                    var custoEnergia = p.Calcular_Custo_Impressao();
                    var custoTotal = p.Calcular_Custo_Total();
                    var lucro = p.Lucro_Liquido();
                    var estoqueAtual = RepositorioTechToys.ObterQuantidadeEstoque<Produto>(p.Id);
                    var valorEstoque = p.Calcular_Custo_Total() * (double)estoqueAtual;
                    var margem = p.Valor_Venda > 0 ? (lucro / p.Valor_Venda) * 100 : 0;
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Nome</td>
                        <td>R$ @custoMp.ToString("N2")</td>
                        <td>R$ @custoEnergia.ToString("N2")</td>
                        <td><strong>R$ @custoTotal.ToString("N2")</strong></td>
                        <td>R$ @p.Valor_Venda.ToString("N2")</td>
                        <td class="@(lucro >= 0 ? "text-success" : "text-danger")">
                            R$ @lucro.ToString("N2")
                        </td>
                        <td class="@(margem >= 40 ? "text-success" : margem >= 0 ? "text-warning" : "text-danger")">
                            @margem.ToString("N1") %
                        </td>
                        <td>@estoqueAtual</td>
                        <td>R$ @valorEstoque.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-secondary">
                <tr>
                    <td colspan="5"><strong>Totais do Estoque Atual</strong></td>
                    <td><strong>R$ @(lista.Sum(p => p.Valor_Venda * (double)RepositorioTechToys.ObterQuantidadeEstoque<Produto>(p.Id)).ToString("N2"))</strong></td>
                    <td><strong>R$ @(lista.Sum(p => p.Lucro_Liquido() * (double)RepositorioTechToys.ObterQuantidadeEstoque<Produto>(p.Id)).ToString("N2"))</strong></td>
                    <td colspan="2"></td>
                    <td><strong>R$ @(lista.Sum(p => p.Calcular_Custo_Total() * (double)RepositorioTechToys.ObterQuantidadeEstoque<Produto>(p.Id)).ToString("N2"))</strong></td>
                </tr>
            </tfoot>
        </table>

        <div class="area-botoes gap-2 mt-3">
            <a class="btn btn-primary" href="/produtos/cadastrar">Ir para Cadastro de Produtos</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum produto cadastrado no sistema.</p>
        <div class="area-botoes gap-2">
            <a class="btn btn-primary" href="/produtos/cadastrar">Cadastrar Produto</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<Produto> lista = new();
    private bool carregando = true;

    protected override void OnInitialized() => Carregar();
    protected override void OnParametersSet() => Carregar();

    private void Carregar()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Produto>() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}