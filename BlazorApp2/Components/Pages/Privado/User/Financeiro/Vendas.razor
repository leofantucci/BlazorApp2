@page "/financeiro/vendas"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject IJSRuntime JS

<PageTitle>Financeiro - Vendas</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Resultados Financeiros de Vendas</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Calculando resultados...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Data</th>
                    <th>Cliente</th>
                    <th>Receita (Venda)</th>
                    <th>Custo Prod.</th>
                    <th>Custo Emb.</th>
                    <th>Lucro Líquido</th>
                    <th>Margem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in lista.OrderByDescending(x => x.Data_Hora))
                {
                    var receita = v.Calcular_Lucro_Bruto();
                    var custoP = v.Calcular_Custo_Producao();
                    var custoE = v.Calcular_Custo_Embalagens();
                    var lucro = v.Calcular_Lucro_Liquido();
                    var margem = receita > 0 ? (lucro / receita) * 100 : 0;

                    <tr>
                        <td>@v.Id</td>
                        <td>@v.Data_Hora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Cliente?.Nome</td>
                        <td>R$ @receita.ToString("N2")</td>
                        <td>R$ @custoP.ToString("N2")</td>
                        <td>R$ @custoE.ToString("N2")</td>
                        <td class="@(lucro >= 0 ? "text-success fw-bold" : "text-danger fw-bold")">
                            R$ @lucro.ToString("N2")
                        </td>
                        <td>@margem.ToString("N1") %</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="area-botoes gap-2 mt-3">
            <a class="btn btn-primary" href="/vendas/cadastrar">Ir para Cadastro de Vendas</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma venda registrada no sistema.</p>
        <div class="area-botoes gap-2">
            <a class="btn btn-primary" href="/vendas/cadastrar">Registrar Venda</a>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<Venda> lista = new();
    private bool carregando = true;

    protected override void OnInitialized() => Carregar();
    protected override void OnParametersSet() => Carregar();

    private void Carregar()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Venda>() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar vendas: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}