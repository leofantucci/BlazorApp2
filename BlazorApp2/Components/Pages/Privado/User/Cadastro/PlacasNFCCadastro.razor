@page "/placas/nfc"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente")]

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorApp2.Security
@using BlazorApp2.Infrastructure
@using TechToysDominio
@using Repositorio
@using System.Security.Cryptography
@inject IDbContextFactory<MyDBContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<PlacasNFCCadastro> Logger

<PageTitle>Placas NFC - Cadastro</PageTitle>

<div class="centralizado pagina-formulario placas-nfc-admin-page">
    <div class="faixaNinja corSecundaria"><p>Placas NFC - Super Placas</p></div>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger") form-alert">@mensagem</div>
    }

    <div class="blueprint blueprint-2 formulario-card">
        <div class="formulario-intro">
            <h2>Gerar nova placa NFC</h2>
            <p>O código de ativação será entregue ao cliente junto com a placa. A URL abaixo é a que deve ser gravada na tag NFC.</p>
        </div>

        <div class="formulario-secao">
            <div class="form-grid">
                <div class="form-field form-field-full">
                    <label class="form-label" for="placaNome">Nome / identificação</label>
                    <input id="placaNome" class="form-control" maxlength="120" @bind="nomeNovo" placeholder="Ex.: Placa da Loja Centro" />
                </div>

                <div class="form-field">
                    <label class="form-label" for="placaCliente">Cliente (opcional)</label>
                    <select id="placaCliente" class="form-control" @bind="clienteId">
                        <option value="0">Sem cliente</option>
                        @foreach (var cliente in clientes)
                        {
                            <option value="@cliente.Id">@cliente.Id - @cliente.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label class="form-label" for="placaProduto">Produto vendido (opcional)</label>
                    <select id="placaProduto" class="form-control" @bind="produtoId">
                        <option value="0">Sem produto</option>
                        @foreach (var produto in produtos)
                        {
                            <option value="@produto.Id">@produto.Id - @produto.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-field form-field-full">
                    <label class="form-label" for="placaQr">QR Code vinculado (opcional)</label>
                    <select id="placaQr" class="form-control" @bind="qrCodeId">
                        <option value="0">Nenhum QR Code</option>
                        @foreach (var qr in qrCodes)
                        {
                            <option value="@qr.Id">@(string.IsNullOrWhiteSpace(qr.Nome) ? qr.CodigoPublico : qr.Nome) (@qr.Status)</option>
                        }
                    </select>
                    <span class="form-help">O QR Code é apenas associado à placa; o funcionamento dele continua independente.</span>
                </div>
            </div>
        </div>

        <div class="formulario-footer">
            <button type="button" class="btn btn-primary" @onclick="CriarPlaca" disabled="@processando">
                @(processando ? "Gerando..." : "Gerar placa NFC")
            </button>
            <a class="btn btn-secondary" href="/placas/qr">Gerenciar QR Codes</a>
        </div>
    </div>

    @if (placaCriada is not null && !string.IsNullOrWhiteSpace(codigoAtivacaoGerado))
    {
        <div class="alert alert-warning form-alert text-start">
            <h5>Placa criada! Guarde o código de ativação.</h5>
            <p>Entregue este código ao cliente junto com a placa. Administradores podem consultá-lo depois pelo botão "Ver código".</p>

            <div class="d-flex flex-wrap align-items-start gap-4">
                @if (!string.IsNullOrWhiteSpace(imagemQrVinculada))
                {
                    <div class="d-flex flex-column align-items-center gap-2">
                        <img src="@imagemQrVinculada" alt="QR Code vinculado" style="width:150px;height:150px;background:white;padding:8px;border:1px solid #ddd;" />
                        <small>QR Code vinculado</small>
                    </div>
                }

                <div class="flex-grow-1">
                    <div><strong>Código de ativação:</strong></div>
                    <div class="fs-4 fw-bold" style="letter-spacing:2px">@codigoAtivacaoGerado</div>

                    <div class="mt-3"><strong>URL da tag NFC:</strong></div>
                    <code class="placa-nfc-url">@urlTagGerada</code>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => CopiarUrl(urlTagGerada)">Copiar URL</button>
                        <a class="btn btn-sm btn-secondary" href="@ObterUrlTag(placaCriada.CodigoPublico)" target="_blank">Abrir página pública</a>
                        <a class="btn btn-sm btn-secondary" href="@ObterUrlEditar(placaCriada.CodigoPublico)" target="_blank">Painel do cliente</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <h5 class="mt-4">Placas cadastradas</h5>

    @if (carregando)
    {
        <p>Carregando placas...</p>
    }
    else if (lista.Count == 0)
    {
        <p class="text-muted">Nenhuma placa NFC cadastrada.</p>
    }
    else
    {
        <div class="tabela-container">
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle mt-2">
                    <thead class="table-dark">
                        <tr>
                            <th>QR vinculado</th>
                            <th>Placa</th>
                            <th>Cliente</th>
                            <th>Produto</th>
                            <th>Status</th>
                            <th>Cards</th>
                            <th>Acessos</th>
                            <th>Último acesso</th>
                            <th>URL da tag</th>
                            <th>Gerenciar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in lista)
                        {
                            <tr>
                                <td>
                                    @if (item.QRCode is not null)
                                    {
                                        <div class="d-flex flex-column align-items-center gap-1">
                                            <img src="@ObterImagemQr(item.QRCode.CodigoPublico)" alt="QR Code vinculado" style="width:80px;height:80px;background:white;padding:4px;" />
                                            <small>@(string.IsNullOrWhiteSpace(item.QRCode.Nome) ? item.QRCode.CodigoPublico : item.QRCode.Nome)</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(item.Nome) ? "Sem nome" : item.Nome)</strong>
                                    <div class="small text-muted">Criada em @item.DataCriacaoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>@(item.Cliente?.Nome ?? "Sem cliente")</td>
                                <td>@(item.Produto?.Nome ?? "Sem produto")</td>
                                <td><span class="badge @ClasseStatus(item.Status)">@item.Status</span></td>
                                <td>@item.Cards.Count</td>
                                <td>@item.TotalAcessos</td>
                                <td>@(item.UltimoAcessoUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nunca")</td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <code class="placa-nfc-url placa-nfc-url-tabela">@ObterUrlTag(item.CodigoPublico)</code>
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => CopiarUrl(ObterUrlTag(item.CodigoPublico))">Copiar URL</button>
                                    </div>
                                </td>
                                <td>
                                    <div class="placas-nfc-acoes">
                                        <a class="btn btn-sm btn-outline-secondary" href="@ObterUrlTag(item.CodigoPublico)" target="_blank">Abrir</a>
                                        <a class="btn btn-sm btn-outline-secondary" href="@ObterUrlEditar(item.CodigoPublico)" target="_blank">Painel do cliente</a>
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AbrirEdicaoVinculo(item)">Editar vínculo</button>
                                        <AuthorizeView Roles="admin">
                                            <button type="button" class="btn btn-sm btn-outline-dark" @onclick="() => VerCodigo(item)">Ver código</button>
                                        </AuthorizeView>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => PerguntarExclusao(item)">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="area-botoes">
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    </div>
</div>

@if (itemExcluir is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar exclusão</h5>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja excluir a placa <strong>@(string.IsNullOrWhiteSpace(itemExcluir.Nome) ? itemExcluir.CodigoPublico : itemExcluir.Nome)</strong>?</p>
                    <p class="text-danger">Essa ação não pode ser desfeita e os cards vinculados também serão removidos.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelarExclusao">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarExclusao">Sim, excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@if (itemCodigo is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Código de ativação</h5>
                </div>
                <div class="modal-body">
                    @if (itemCodigo.Status == StatusPlacaNFC.Pendente && !string.IsNullOrWhiteSpace(itemCodigo.CodigoAtivacao))
                    {
                        <p>Entregue este código ao cliente junto com a placa.</p>
                        <div class="fs-4 fw-bold" style="letter-spacing:2px">@itemCodigo.CodigoAtivacao</div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Esta placa já foi ativada ou o código não está mais disponível.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="FecharCodigo">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (itemEditar is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar vínculo da placa</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Fechar" @onclick="FecharEdicaoVinculo"></button>
                </div>
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-field form-field-full">
                            <label class="form-label">Nome / identificação</label>
                            <input class="form-control" maxlength="120" @bind="editNome" />
                        </div>
                        <div class="form-field">
                            <label class="form-label">Cliente</label>
                            <select class="form-control" @bind="editClienteId">
                                <option value="0">Sem cliente</option>
                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.Id">@cliente.Id - @cliente.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Produto</label>
                            <select class="form-control" @bind="editProdutoId">
                                <option value="0">Sem produto</option>
                                @foreach (var produto in produtos)
                                {
                                    <option value="@produto.Id">@produto.Id - @produto.Nome</option>
                                }
                            </select>
                        </div>
                        <div class="form-field form-field-full">
                            <label class="form-label">QR Code vinculado</label>
                            <select class="form-control" @bind="editQrCodeId">
                                <option value="0">Nenhum QR Code</option>
                                @foreach (var qr in qrCodes)
                                {
                                    <option value="@qr.Id">@(string.IsNullOrWhiteSpace(qr.Nome) ? qr.CodigoPublico : qr.Nome) (@qr.Status)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="FecharEdicaoVinculo">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SalvarVinculo" disabled="@processando">Salvar vínculo</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PlacaNFC> lista = new();
    private List<Cliente> clientes = new();
    private List<Produto> produtos = new();
    private List<QRCode> qrCodes = new();

    private bool carregando = true;
    private bool processando;
    private string mensagem = string.Empty;
    private bool sucesso = true;

    private string nomeNovo = string.Empty;
    private int clienteId;
    private int produtoId;
    private int qrCodeId;

    private PlacaNFC? placaCriada;
    private string codigoAtivacaoGerado = string.Empty;
    private string urlTagGerada = string.Empty;
    private string imagemQrVinculada = string.Empty;

    private PlacaNFC? itemExcluir;
    private PlacaNFC? itemCodigo;
    private PlacaNFC? itemEditar;
    private string editNome = string.Empty;
    private int editClienteId;
    private int editProdutoId;
    private int editQrCodeId;

    protected override async Task OnInitializedAsync() => await CarregarDados();

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            lista = await db.PlacaNFC
                .AsNoTracking()
                .Include(x => x.Cliente)
                .Include(x => x.Produto)
                .Include(x => x.QRCode)
                .Include(x => x.Cards)
                .OrderByDescending(x => x.DataCriacaoUtc)
                .ToListAsync();

            clientes = await db.Cliente.AsNoTracking().OrderBy(x => x.Nome).ToListAsync();
            produtos = await db.Produto.AsNoTracking().OrderBy(x => x.Nome).ToListAsync();
            qrCodes = await db.QRCode.AsNoTracking().OrderByDescending(x => x.DataCriacaoUtc).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[PlacaNFC] Falha ao carregar placas.");
            mensagem = "Não foi possível carregar as placas. Consulte os registros do servidor.";
            sucesso = false;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CriarPlaca()
    {
        if (processando) return;

        processando = true;
        mensagem = string.Empty;
        codigoAtivacaoGerado = string.Empty;
        placaCriada = null;
        imagemQrVinculada = string.Empty;

        try
        {
            var token = Convert.ToBase64String(RandomNumberGenerator.GetBytes(24))
                .Replace("+", "-").Replace("/", "_").TrimEnd('=');
            var codigoAtivacao = Convert.ToHexString(RandomNumberGenerator.GetBytes(5))
                .ToUpperInvariant();

            var nova = new PlacaNFC
            {
                CodigoPublico = token,
                Nome = string.IsNullOrWhiteSpace(nomeNovo) ? null : nomeNovo.Trim(),
                ClienteId = clienteId > 0 ? clienteId : null,
                ProdutoId = produtoId > 0 ? produtoId : null,
                QRCodeId = qrCodeId > 0 ? qrCodeId : null,
                Status = StatusPlacaNFC.Pendente,
                DataCriacaoUtc = DateTime.UtcNow
            };
            nova.CodigoAtivacao = codigoAtivacao;
            nova.CodigoAtivacaoHash = new PasswordHasher<PlacaNFC>()
                .HashPassword(nova, codigoAtivacao);

            await using var db = await DbFactory.CreateDbContextAsync();
            db.PlacaNFC.Add(nova);
            await db.SaveChangesAsync();

            placaCriada = nova;
            codigoAtivacaoGerado = codigoAtivacao;
            urlTagGerada = ObterUrlTag(token);

            var qr = qrCodes.FirstOrDefault(x => x.Id == nova.QRCodeId);
            imagemQrVinculada = qr is null
                ? string.Empty
                : QrCodeImage.ObterPngDataUrl(ObterUrlQr(qr.CodigoPublico));

            nomeNovo = string.Empty;
            clienteId = 0;
            produtoId = 0;
            qrCodeId = 0;

            mensagem = "Placa NFC criada com sucesso.";
            sucesso = true;
            await CarregarDados();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[PlacaNFC] Falha ao criar placa.");
            mensagem = "Erro ao criar placa NFC. Consulte os registros do servidor.";
            sucesso = false;
        }
        finally
        {
            processando = false;
        }
    }

    private string ObterUrlTag(string codigoPublico)
        => new Uri(new Uri(Navigation.BaseUri), $"placas/nfc/{codigoPublico}").ToString();

    private string ObterUrlEditar(string codigoPublico)
        => new Uri(new Uri(Navigation.BaseUri), $"placas/nfc/{codigoPublico}/editar").ToString();

    private string ObterUrlQr(string codigoPublico)
        => new Uri(new Uri(Navigation.BaseUri), $"placas/qr/{codigoPublico}").ToString();

    private string ObterImagemQr(string codigoPublico)
        => QrCodeImage.ObterPngDataUrl(ObterUrlQr(codigoPublico));

    private async Task CopiarUrl(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            mensagem = "URL copiada para a área de transferência.";
            sucesso = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[PlacaNFC] Não foi possível copiar a URL.");
            mensagem = $"Não foi possível copiar automaticamente. Copie manualmente: {url}";
            sucesso = false;
        }
    }

    private async Task VerCodigo(PlacaNFC item)
    {
        // Defesa em profundidade: a página aceita admin e gerente, mas o código de
        // ativação só pode ser revelado a administradores, mesmo via evento forjado.
        var autenticacao = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!PlacaNfcAccessPolicy.PodeVerCodigoAtivacao(autenticacao.User))
        {
            mensagem = "Apenas administradores podem visualizar o código de ativação.";
            sucesso = false;
            return;
        }

        itemCodigo = item;
    }

    private void FecharCodigo() => itemCodigo = null;

    private void PerguntarExclusao(PlacaNFC item) => itemExcluir = item;

    private void CancelarExclusao() => itemExcluir = null;

    private async Task ConfirmarExclusao()
    {
        if (itemExcluir is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var placa = await db.PlacaNFC.FirstOrDefaultAsync(x => x.Id == itemExcluir.Id);
            if (placa is not null)
            {
                db.PlacaNFC.Remove(placa);
                await db.SaveChangesAsync();
            }

            itemExcluir = null;
            mensagem = "Placa NFC excluída com sucesso.";
            sucesso = true;
            await CarregarDados();
        }
        catch (Exception ex)
        {
            itemExcluir = null;
            Logger.LogError(ex, "[PlacaNFC] Falha ao excluir placa.");
            mensagem = "Erro ao excluir placa NFC. Consulte os registros do servidor.";
            sucesso = false;
        }
    }

    private void AbrirEdicaoVinculo(PlacaNFC item)
    {
        itemEditar = item;
        editNome = item.Nome ?? string.Empty;
        editClienteId = item.ClienteId ?? 0;
        editProdutoId = item.ProdutoId ?? 0;
        editQrCodeId = item.QRCodeId ?? 0;
    }

    private void FecharEdicaoVinculo() => itemEditar = null;

    private async Task SalvarVinculo()
    {
        if (itemEditar is null || processando) return;

        processando = true;
        mensagem = string.Empty;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var placa = await db.PlacaNFC.FirstOrDefaultAsync(x => x.Id == itemEditar.Id);
            if (placa is null)
            {
                mensagem = "Placa não encontrada.";
                sucesso = false;
                return;
            }

            placa.Nome = string.IsNullOrWhiteSpace(editNome) ? null : editNome.Trim();
            placa.ClienteId = editClienteId > 0 ? editClienteId : null;
            placa.ProdutoId = editProdutoId > 0 ? editProdutoId : null;
            placa.QRCodeId = editQrCodeId > 0 ? editQrCodeId : null;
            placa.DataAtualizacaoUtc = DateTime.UtcNow;

            await db.SaveChangesAsync();

            itemEditar = null;
            mensagem = "Vínculo da placa atualizado com sucesso.";
            sucesso = true;
            await CarregarDados();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[PlacaNFC] Falha ao editar vínculo da placa.");
            mensagem = "Erro ao atualizar o vínculo da placa. Consulte os registros do servidor.";
            sucesso = false;
        }
        finally
        {
            processando = false;
        }
    }

    private void Voltar() => Navigation.NavigateTo("/placas");

    private static string ClasseStatus(StatusPlacaNFC status) => status switch
    {
        StatusPlacaNFC.Ativo => "bg-success",
        StatusPlacaNFC.Pendente => "bg-warning text-dark",
        StatusPlacaNFC.Bloqueado => "bg-danger",
        _ => "bg-secondary"
    };
}
