@page "/embalagens/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Embalagens - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Embalagens - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando embalagens...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Custo (R$)</th>
                    <th>Estoque (UN)</th>
                    <th>Fornecedor - Nome</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <a href="/embalagens/visualizar/@item.Id/mais-detalhes" title="Ver detalhes">
                                <img class="foto-3" src="Media/visualizar-dark.webp" alt="Ver detalhes">
                            </a>
                        </td>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Tipo</td>
                        <td>(@item.largura, @item.comprimento, @item.altura)</td>
                        <td>@item.Preco.ToString("F2")</td>
                        <td>@(RepositorioTechToys.ObterQuantidadeEstoque<Embalagem>(item.Id))</td>
                        <td>@(item.Fornecedor?.Nome ?? "Não informado")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/embalagens/cadastrar">Novo Embalagem</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/embalagens/editar">Editar Embalagem</a>
                <a class="btn btn-primary" href="/embalagens/remover">Remover Embalagem</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma embalagem cadastrada no momento.</p>
        <div class="area-botoes gap-2">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/embalagens/cadastrar">Nova Embalagem</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/embalagens/editar">Editar Embalagem</a>
                <a class="btn btn-primary" href="/embalagens/remover">Remover Embalagem</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<Embalagem> lista = new List<Embalagem>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    // Garante a recarga mesmo navegando de outra tela sem destruir o circuito
    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Embalagem>() ?? new List<Embalagem>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
