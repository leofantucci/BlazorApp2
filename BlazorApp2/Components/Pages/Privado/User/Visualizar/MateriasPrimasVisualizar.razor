@page "/materias-primas/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Materias-Primas - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Materias-Primas - Visualizar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
            <tr>
                <th style="width: 50px;"></th>
                <th>ID</th>
                <th>Nome</th>
                <th>Preço(R$)/grama</th>
                <th>Estoque (g)</th>
                <th>Fornecedor - Nome</th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td><a href="/materias-primas/visualizar/@item.Id/mais-detalhes"><img class="foto-3" src="Media/visualizar-dark.webp" alt="Ver detalhes"></a></td>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>R$ @item.Calcular_Preco_Grama().ToString("F2")</td>
                        <td>@(RepositorioTechToys.ObterQuantidadeEstoque<MateriaPrima>(item.Id)) g</td>
                        <td>@(item.Fornecedor?.Nome ?? "Não informado")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/materias-primas/cadastrar">Nova Matéria-prima</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/materias-primas/editar">Editar Matéria-prima</a>
                <a class="btn btn-primary" href="/materias-primas/remover">Remover Matéria-prima</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum(a) matéria-prima cadastrado(a) no momento.</p>
        <div class="area-botoes gap-2">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/materias-primas/cadastrar">Novo(a) Matéria-prima</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/materias-primas/editar">Editar Matéria-prima</a>
                <a class="btn btn-primary" href="/materias-primas/remover">Remover Matéria-prima</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<MateriaPrima> lista = new List<MateriaPrima>();

    // Executado automaticamente assim que a página é carregada
    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            // Usa a instância injetada via @inject
            lista = RepositorioTechToys.ListarTodos<MateriaPrima>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
