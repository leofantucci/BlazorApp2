@page "/vendas/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Vendas - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Vendas - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando vendas...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3 align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>ID</th>
                    <th>Data/Hora</th>
                    <th>Cliente - Nome</th>
                    <th>Produtos (Qtd x Nome - Preço Unit.)</th>
                    <th>Embalagens (Qtd x Nome - Preço Unit.)</th>
                    <th>Total (R$)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <a href="/vendas/visualizar/@item.Id/mais-detalhes" title="Ver detalhes">
                                <img class="foto-3" src="Media/visualizar-dark.webp" alt="Ver detalhes">
                            </a>
                        </td>
                        <td>@item.Id</td>
                        <td>@item.Data_Hora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.Cliente?.Nome ?? "Cliente não informado")</td>
                        <td>
                            @if (item.ItensVenda != null && item.ItensVenda.Count > 0)
                            {
                                @foreach (var prod in item.ItensVenda)
                                {
                                    <div>
                                        <strong>@(prod.Quantidade)x</strong> @(prod.Produto?.Nome ?? "Produto não informado")
                                        <span class="text-muted">(R$ @(prod.Produto?.Valor_Venda.ToString("F2") ?? "0,00"))</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Nenhum produto</span>
                            }
                        </td>
                        <td>
                            @if (item.EmbalagensVenda != null && item.EmbalagensVenda.Count > 0)
                            {
                                @foreach (var emb in item.EmbalagensVenda)
                                {
                                    <div>
                                        <strong>@(emb.Quantidade)x</strong> @(emb.Embalagem?.Nome ?? "Embalagem não informada")
                                        <span class="text-muted">(R$ @(emb.Embalagem?.Preco.ToString("F2") ?? "0,00"))</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Sem embalagem</span>
                            }
                        </td>
                        <td>@item.Calcular_Lucro_Bruto().ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <AuthorizeView Roles="admin, gerente, funcionario"><a class="btn btn-primary" href="/vendas/cadastrar">Nova Venda</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/vendas/editar">Editar Venda</a>
                <a class="btn btn-primary" href="/vendas/remover">Remover Venda</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhuma venda cadastrada no momento.</p>
        <div class="area-botoes gap-2">
            <AuthorizeView Roles="admin, gerente, funcionario"><a class="btn btn-primary" href="/vendas/cadastrar">Nova Venda</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/vendas/editar">Editar Venda</a>
                <a class="btn btn-primary" href="/vendas/remover">Remover Venda</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<Venda> lista = new List<Venda>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Venda>() ?? new List<Venda>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
