@page "/fornecedores/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Fornecedores - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Fornecedores - Visualizar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Site</th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Email</td>
                        <td>@item.Telefone</td>
                        <td>@item.Site</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/fornecedores/cadastrar">Novo Fornecedor</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/fornecedores/editar">Editar Fornecedor</a>
                <a class="btn btn-primary" href="/fornecedores/remover">Remover Fornecedor</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum fornecedor cadastrado no momento.</p>
        <div class="area-botoes gap-2">
            <AuthorizeView Roles="admin, gerente"><a class="btn btn-primary" href="/fornecedores/cadastrar">Novo Fornecedor</a></AuthorizeView>
            <AuthorizeView Roles="admin, gerente">
                <a class="btn btn-primary" href="/fornecedores/editar">Editar Fornecedor</a>
                <a class="btn btn-primary" href="/fornecedores/remover">Remover Fornecedor</a>
            </AuthorizeView>
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
</div>

@code {
    public List<Fornecedor> lista = new List<Fornecedor>();

    // Executado automaticamente assim que a página é carregada
    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            // Usa a instância injetada via @inject
            lista = RepositorioTechToys.ListarTodos<Fornecedor>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
