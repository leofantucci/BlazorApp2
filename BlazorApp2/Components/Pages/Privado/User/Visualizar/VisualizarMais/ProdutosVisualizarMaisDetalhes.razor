@page "/produtos/visualizar/{id:int}/mais-detalhes"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin, gerente, funcionario")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Produto @Id - Mais Detalhes</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria">
        <p>Produto @Id - Mais Detalhes</p>
    </div>

    @if (carregando)
    {
        <div class="spinner-border text-primary my-4" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    }
    else if (produto != null)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr><th>ID</th><th>Nome</th><th>Valor de venda</th><th>Custo total</th><th>Lucro unitário</th><th>Tempo por unidade</th><th>Tempo por lote (10 un.)</th><th>Estoque</th><th>Ativo</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>@produto.Id</td><td>@produto.Nome</td>
                    <td>R$ @produto.Valor_Venda.ToString("F2")</td>
                    <td>R$ @produto.Calcular_Custo_Total().ToString("F2")</td>
                    <td>R$ @produto.Lucro_Liquido().ToString("F2")</td>
                    <td>@FormatarTempo(TempoPorUnidadeMinutos)</td>
                    <td>@FormatarTempo(TempoPorUnidadeMinutos * 10)</td>
                    <td>@(RepositorioTechToys.ObterQuantidadeEstoque<Produto>(produto.Id))</td>
                    <td>@(produto.Ativo ? "Sim" : "Não")</td>
                </tr>
            </tbody>
        </table>

        <h4>Composição do produto</h4>
        @if (produto.Composicao.Count == 0)
        {
            <div class="alert alert-warning">Este produto ainda não possui peças na composição.</div>
        }
        else
        {
            <table class="table table-striped table-bordered">
                <thead class="table-dark"><tr><th>Peça</th><th>Quantidade por produto</th><th>Peso por peça</th><th>Tempo por peça</th><th>Tempo total no produto</th><th>Matérias-primas / cores</th></tr></thead>
                <tbody>
                @foreach (var linha in produto.Composicao)
                {
                    <tr><td>@linha.Peca.Nome (ID @linha.PecaId)</td><td>@linha.Quantidade</td><td>@linha.Peca.Peso_Impressao.ToString("N3") g</td><td>@FormatarTempo(linha.Peca.Tempo_Impressao)</td><td>@FormatarTempo(linha.Peca.Tempo_Impressao * linha.Quantidade)</td><td>@(linha.Peca.MateriasPrimas.Count > 0 ? string.Join("; ", linha.Peca.MateriasPrimas.Select(m => $"{m.MateriaPrima.Nome}: {m.Peso:N3} g")) : (linha.Peca.Materia_Prima?.Nome ?? "Não informada"))</td></tr>
                }
                </tbody>
            </table>
        }

        <div class="mt-3">
            <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            Produto com ID <strong>@Id</strong> não encontrado.
        </div>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Produto? produto;
    private bool carregando = true;
    private double TempoPorUnidadeMinutos => produto?.Composicao.GroupBy(x => x.Peca.Impressora?.Id ?? -x.Peca.Id).Select(g => g.Sum(x => x.Peca.Tempo_Impressao * x.Quantidade)).DefaultIfEmpty(0).Max() ?? 0;
    private static string FormatarTempo(double minutos) => minutos <= 0 ? "Não informado" : TimeSpan.FromMinutes(minutos).TotalDays >= 1 ? TimeSpan.FromMinutes(minutos).ToString(@"d\d\ hh\h\ mm\m") : TimeSpan.FromMinutes(minutos).ToString(@"hh\h\ mm\m");

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            produto = RepositorioTechToys.ObterPorId<Produto>(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes do produto: {ex.Message}");
            produto = null;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Voltar()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
