@page "/embalagens/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Embalagens - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Embalagens - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando embalagens...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Custo (R$)</th>
                    <th>Estoque</th>
                    <th>Fornecedor - Nome</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <a href="/embalagens/visualizar/@item.Id/mais-detalhes" title="Ver detalhes">
                                <img class="foto-3" src="Media/visualizar-dark.png" alt="Ver detalhes">
                            </a>
                        </td>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Tipo</td>
                        <td>(@item.largura, @item.comprimento, @item.altura)</td>
                        <td>@item.Preco.ToString("F2")</td>
                        <td>@item.Estoque</td>
                        <td>@item.Fornecedor.Nome</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/embalagens/cadastrar">Novo Embalagem</a>
            <a class="btn btn-secondary" href="/embalagens">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum Embalagem cadastrado no momento.</p>
        <a class="btn btn-primary" href="/embalagens/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/embalagens">Voltar</a>
    }
</div>

@code {
    public List<Embalagem> lista = new List<Embalagem>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    // Garante a recarga mesmo navegando de outra tela sem destruir o circuito
    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Embalagem>() ?? new List<Embalagem>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}