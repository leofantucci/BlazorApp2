@page "/embalagens/visualizar/{id:int}/mais-detalhes"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Embalagem @Id - Mais Detalhes</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria">
        <p>Embalagem @Id - Mais Detalhes</p>
    </div>

    @if (carregando)
    {
        <div class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>
    }
    else if (embalagem != null)
    {
        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Tipo</th>
                        <th>Dimensões (L × C × A)</th>
                        <th>Preço Unit. (R$)</th>
                        <th>Estoque - Qtd.</th>
                        <th>Estoque - Total (R$)</th>
                        <th>Fornecedor - ID</th>
                        <th>Fornecedor - Nome</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@embalagem.Id</td>
                        <td>@embalagem.Nome</td>
                        <td>@(string.IsNullOrWhiteSpace(embalagem.Tipo) ? "-" : embalagem.Tipo)</td>
                        <td>@($"{embalagem.largura} × {embalagem.comprimento} × {embalagem.altura} mm")</td>
                        <td>@embalagem.Preco.ToString("C2")</td>
                        <td>@embalagem.Estoque</td>
                        <td>@embalagem.Calcular_Valor_Estoque().ToString("C2")</td>
                        
                        <td>@(embalagem.Fornecedor?.Id ?? 0)</td>
                        <td>@(embalagem.Fornecedor?.Nome ?? "Sem Fornecedor")</td>
                        </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <a class="btn btn-secondary" href="/embalagens">Voltar</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            Embalagem com ID <strong>@Id</strong> não encontrada.
        </div>
        <a class="btn btn-secondary" href="/embalagens">Voltar</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Embalagem? embalagem;
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            embalagem = RepositorioTechToys.ObterPorId<Embalagem>(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes da embalagem: {ex.Message}");
            embalagem = null;
        }
        finally
        {
            carregando = false;
        }
    }
}