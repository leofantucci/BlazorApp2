@page "/produtos/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Produtos - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Produtos - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando produtos...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Valor de Venda (R$)</th>
                    <th>Estoque</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <a href="/produtos/@item.Id/mais-detalhes" title="Ver detalhes">
                                <img class="foto-3" src="Media/visualizar-dark.png" alt="Ver detalhes">
                            </a>
                        </td>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>(@item.largura, @item.comprimento, @item.altura)</td>
                        <td>R$ @item.Valor_Venda.ToString("F2")</td>
                        <td>@item.Estoque</td>
                        <td>
                            @if (item.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/produtos/cadastrar">Novo Produto</a>
            <a class="btn btn-secondary" href="/produtos">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum produto cadastrado no momento.</p>
        <a class="btn btn-primary" href="/produtos/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/produtos">Voltar</a>
    }
</div>

@code {
    public List<Produto> lista = new List<Produto>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    // Garante a recarga mesmo navegando de outra tela sem destruir o circuito
    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Produto>() ?? new List<Produto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}