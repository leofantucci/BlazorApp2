@page "/impressoras/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Impressoras - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Impressoras - Visualizar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Modelo</th>
                <th>Consumo (kWh)</th>
                <th>Custo/Hora Estimado</th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Modelo</td>
                        <td>@item.Kwh.ToString("F2")</td>
                        <td>R$ @item.Calcular_Custo_Impressao(60).ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/impressoras/cadastrar">Nova Impressora</a>
            <a class="btn btn-secondary" href="/impressoras">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1">Nenhuma impressora cadastrada no momento.</p>
        <a class="btn btn-primary" href="/impressoras/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/impressoras">Voltar</a>
    }
</div>

@code {
    public List<Impressora> lista = new List<Impressora>();

    // Executado automaticamente assim que a página é carregada
    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            // Usa a instância injetada via @inject
            lista = RepositorioTechToys.ListarTodos<Impressora>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
    }
}