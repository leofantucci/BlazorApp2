@page "/clientes/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Clientes - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Clientes - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando clientes...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Telefone</th>
                    <th>Email</th>
                    <th>Instagram</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>(@item.Telefone)</td>
                        <td>(@item.Email)</td>
                        <td>(@item.Instagram)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/clientes/cadastrar">Novo Cliente</a>
            <a class="btn btn-secondary" href="/clientes">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum cliente cadastrado no momento.</p>
        <a class="btn btn-primary" href="/clientes/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/clientes">Voltar</a>
    }
</div>

@code {
    public List<Cliente> lista = new List<Cliente>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    // Garante a recarga mesmo navegando de outra tela sem destruir o circuito
    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Cliente>() ?? new List<Cliente>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}