@page "/materias-primas/visualizar/{id:int}/mais-detalhes"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Matéria-Prima @Id - Mais Detalhes</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria">
        <p>Matéria-Prima @Id - Mais Detalhes</p>
    </div>

    @if (carregando)
    {
        <div class="spinner-border text-primary my-4" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    }
    else if (materiaprima != null)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Compra - Peso (g)</th>
                    <th>Compra - Preço (R$)</th>
                    <th>Preço(R$)/grama</th>
                    <th>Fornecedor - ID</th>
                    <th>Fornecedor - Nome</th>
                    <th>Estoque - Qtd. (g)</th>
                    <th>Estoque - Total (R$)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@materiaprima.Id</td>
                    <td>@materiaprima.Nome</td>
                    <td>@materiaprima.Peso_compra</td>
                    <td>@materiaprima.Preco_compra</td>
                    <td>R$ @materiaprima.Calcular_Preco_Grama().ToString("F2") ?? "0,00"</td>
                    <td>@materiaprima.Fornecedor.Id</td>
                    <td>@materiaprima.Fornecedor.Id</td>
                    <td>@materiaprima.Estoque g</td>
                    <td>R$ @materiaprima.Calcular_Valor_Estoque().ToString("F2") ?? "0,00"</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-secondary" href="/materia-prima">Voltar</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            Matéria-Prima com ID <strong>@Id</strong> não encontrada.
        </div>
        <a class="btn btn-secondary" href="/materias-primas">Voltar</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public MateriaPrima? materiaprima;
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;

            // Busca a materia-prima específica pelo ID recebido na rota
            // (Ajuste o método abaixo conforme a assinatura do seu Repositório)
            materiaprima = RepositorioTechToys.ObterPorId<MateriaPrima>(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes da matéria-prima: {ex.Message}");
            materiaprima = null;
        }
        finally
        {
            carregando = false;
        }
    }
}