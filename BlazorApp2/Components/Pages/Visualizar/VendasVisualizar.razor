@page "/vendas/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Vendas - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Vendas - Visualizar</p></div>

    @if (carregando)
    {
        <p class="texto-padrao-1 mt-3">Carregando vendas...</p>
    }
    else if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>ID</th>
                    <th>Data/Hora</th>
                    <th>Cliente - Nome</th>
                    <th>Produto - Quantidade</th>
                    <th>Produto - Nome</th>
                    <th>Produto - Preço Unit. (R$)</th>
                    <th>Embalagem - Nome</th>
                    <th>Embalagem - Quantidade</th>
                    <th>Embalagem - Preço Unit. (R$)</th>
                    <th>Total (R$)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td class="text-center align-middle">
                            <a href="/vendas/visualizar/@item.Id/mais-detalhes" title="Ver detalhes">
                                <img class="foto-3" src="Media/visualizar-dark.png" alt="Ver detalhes">
                            </a>
                        </td>
                        <td>@item.Id</td>
                        <td>@item.Data_Hora</td>
                        <td>@item.Cliente.Nome</td>
                        <td>@item.Quantidade</td>
                        <td>@item.Produto.Nome</td>
                        <td>@item.Produto.Valor_Venda</td>
                        <td>@item.Embalagem.Nome</td>
                        <td>@item.Quantidade_Embalagem</td>
                        <td>@item.Calcular_Lucro_Bruto()</td>

                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/vendas/cadastrar">Novo Venda</a>
            <a class="btn btn-secondary" href="/vendas">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum Venda cadastrado no momento.</p>
        <a class="btn btn-primary" href="/vendas/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/vendas">Voltar</a>
    }
</div>

@code {
    public List<Venda> lista = new List<Venda>();
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    // Garante a recarga mesmo navegando de outra tela sem destruir o circuito
    protected override void OnParametersSet()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            lista = RepositorioTechToys.ListarTodos<Venda>() ?? new List<Venda>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }
}