@page "/vendas/visualizar/{id:int}/mais-detalhes"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Venda @Id - Mais Detalhes</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria">
        <p>Venda @Id - Mais Detalhes</p>
    </div>

    @if (carregando)
    {
        <div class="spinner-border text-primary my-4" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    }
    else if (venda != null)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Data/Hora</th>
                    <th>Cliente - ID</th>
                    <th>Cliente - Nome</th>
                    <th>Produto - ID</th>
                    <th>Produto - Nome</th>
                    <th>Qtd.</th>
                    <th>Embalagem - ID</th>
                    <th>Embalagem - Nome</th>
                    <th>Embalagem - Qtd.</th>
                    <th>Valor Venda</th>
                    <th>Custo</th>
                    <th>Lucro Líq.</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@venda.Id</td>
                    <td>@venda.Data_Hora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@venda.Cliente?.Id</td>
                    <td>@venda.Cliente?.Nome</td>
                    <td>@venda.Produto?.Id</td>
                    <td>@venda.Produto?.Nome</td>
                    <td>@venda.Quantidade</td>
                    <td>@venda.Embalagem?.Id</td>
                    <td>@venda.Embalagem?.Nome</td>
                    <td>@venda.Quantidade_Embalagem</td>
                    <td>R$ @(venda.Produto?.Valor_Venda.ToString("F2") ?? "0,00")</td>
                    <td>R$ @venda.Calcular_Gasto_Total().ToString("F2")</td>
                    <td>R$ @venda.Calcular_Lucro_Liquido().ToString("F2")</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-secondary" href="/vendas">Voltar</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            Venda com ID <strong>@Id</strong> não encontrada.
        </div>
        <a class="btn btn-secondary" href="/vendas">Voltar</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Venda? venda;
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;

            // Busca a venda específica pelo ID recebido na rota
            // (Ajuste o método abaixo conforme a assinatura do seu Repositório)
            venda = RepositorioTechToys.ObterPorId<Venda>(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes da venda: {ex.Message}");
            venda = null;
        }
        finally
        {
            carregando = false;
        }
    }
}