@page "/produtos/visualizar/{id:int}/mais-detalhes"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Produto @Id - Mais Detalhes</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria">
        <p>Produto @Id - Mais Detalhes</p>
    </div>

    @if (carregando)
    {
        <div class="spinner-border text-primary my-4" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    }
    else if (produto != null)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Peso Impressão (g)</th>
                    <th>Tempo Impressão (min)</th>
                    <th>Dimensões (L, C, A)</th>
                    <th>Matéria-Prima - ID</th>
                    <th>Matéria-Prima - Nome</th>
                    <th>Impressora - ID</th>
                    <th>Impressora - Nome</th>
                    <th>Custo Matéria-Prima (R$)</th>
                    <th>Custo Impressão (R$)</th>
                    <th>Custo Total (R$)</th>
                    <th>Valor Venda (R$)</th>
                    <th>Lucro Líq./Unid. (R$)</th>
                    <th>Estoque - Qtd.</th>
                    <th>Estoque - Valor (R$)</th>
                    <th>Ativo</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@produto.Id</td>
                    <td>@produto.Nome</td>
                    <td>@produto.Peso_Impressao g</td>
                    <td>@produto.Tempo_Impressao min</td>
                    <td>(@produto.largura, @produto.comprimento, @produto.altura)</td>
                    <td>@produto.Materia_Prima.Id</td>
                    <td>@produto.Materia_Prima.Nome</td>
                    <td>@produto.Impressora?.Id</td>
                    <td>@produto.Impressora?.Nome</td>
                    <td>R$ @produto.Calcular_Custo_Materia_Prima().ToString("F2")</td>
                    <td>R$ @produto.Calcular_Custo_Impressao().ToString("F2")</td>
                    <td>R$ @produto.Calcular_Custo_Total().ToString("F2")</td>
                    <td>R$ @produto.Valor_Venda.ToString("F2")</td>
                    <td>R$ @produto.Lucro_Liquido().ToString("F2")</td>
                    <td>@produto.Estoque</td>
                    <td>R$ @produto.Calcular_Valor_Estoque().ToString("F2")</td>
                    <td>@(produto.Ativo ? "Sim" : "Não")</td>
                </tr>
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-secondary" href="/produtos">Voltar</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">
            Produto com ID <strong>@Id</strong> não encontrado.
        </div>
        <a class="btn btn-secondary" href="/produtos">Voltar</a>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Produto? produto;
    private bool carregando = true;

    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            carregando = true;
            produto = RepositorioTechToys.ObterPorId<Produto>(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes do produto: {ex.Message}");
            produto = null;
        }
        finally
        {
            carregando = false;
        }
    }
}