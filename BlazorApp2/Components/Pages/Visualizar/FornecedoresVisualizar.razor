@page "/fornecedores/visualizar"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager

<PageTitle>Fornecedores - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Fornecedores - Visualizar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Site</th>
            </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nome</td>
                        <td>@item.Email</td>
                        <td>@item.Telefone</td>
                        <td>@item.Site</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a class="btn btn-primary" href="/fornecedores/cadastrar">Nova fornecedor</a>
            <a class="btn btn-secondary" href="/fornecedores">Voltar</a>
        </div>
    }
    else
    {
        <p class="texto-padrao-1">Nenhum fornecedor cadastrada no momento.</p>
        <a class="btn btn-primary" href="/fornecedores/cadastrar">Cadastrar Agora</a>
        <a class="btn btn-secondary" href="/fornecedores">Voltar</a>
    }
</div>

@code {
    public List<Fornecedor> lista = new List<Fornecedor>();

    // Executado automaticamente assim que a página é carregada
    protected override void OnInitialized()
    {
        CarregarDados();
    }

    private void CarregarDados()
    {
        try
        {
            // Usa a instância injetada via @inject
            lista = RepositorioTechToys.ListarTodos<Fornecedor>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar lista: {ex.Message}");
        }
    }
}