@page "/usuarios/visualizar"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Usuários - Visualizar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Usuários - Visualizar</p></div>

    @if (lista.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr><th>ID</th><th>Login</th><th>Cargo</th></tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr><td>@item.Id</td><td>@item.Login</td><td>@item.Role</td></tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Nenhum usuário cadastrado no momento.</p>
    }

    <div class="mt-3">
        <a class="btn btn-primary" href="/usuarios/cadastrar">Novo usuário</a>
        <a class="btn btn-primary" href="/usuarios/editar">Editar usuários</a>
        <a class="btn btn-danger" href="/usuarios/remover">Remover usuário</a>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    </div>
</div>

@code {
    private List<Usuario> lista = new();

    protected override void OnInitialized()
    {
        // Projeção evita carregar hashes para a camada de apresentação.
        lista = RepositorioTechToys.ListarUsuariosSemCredenciais();
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}
