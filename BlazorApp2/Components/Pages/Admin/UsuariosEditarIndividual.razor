@page "/usuarios/editar/{id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Usuário - Editar</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Editar usuário</p></div>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger")">@mensagem</div>
    }

    @if (usuario != null)
    {
        <div class="mt-3">
            <div class="mb-3">
                <label class="form-label">Login</label>
                <input class="form-control" maxlength="100" @bind="login" />
            </div>
            <div class="mb-3">
                <label class="form-label">Cargo</label>
                <select class="form-select" @bind="role">
                    <option value="funcionario">Funcionário</option>
                    <option value="gerente">Gerente</option>
                    <option value="admin">Administrador</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Nova senha (deixe em branco para manter a atual)</label>
                <input class="form-control" type="password" autocomplete="new-password"
                       minlength="10" maxlength="1024" @bind="novaSenha" />
            </div>
            <button class="btn btn-primary" @onclick="Salvar">Salvar alterações</button>
            <button class="btn btn-secondary" @onclick="Voltar">Cancelar</button>
        </div>
    }
    else
    {
        <p class="texto-padrao-1 mt-3">Usuário não encontrado.</p>
        <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Usuario? usuario;
    private string login = string.Empty;
    private string role = "funcionario";
    private string novaSenha = string.Empty;
    private string mensagem = string.Empty;
    private bool sucesso;

    protected override void OnParametersSet()
    {
        usuario = RepositorioTechToys.ObterUsuarioSemCredenciais(Id);
        if (usuario != null)
        {
            login = usuario.Login;
            role = usuario.Role;
            // Nunca copiar nem mostrar Senha ou SenhaHash no formulário.
        }
    }

    private void Salvar()
    {
        mensagem = string.Empty;
        sucesso = false;
        try
        {
            RepositorioTechToys.AtualizarUsuario(Id, login, role, novaSenha);
            sucesso = true;
            mensagem = "Usuário atualizado com segurança.";
            NavigationManager.NavigateTo("/usuarios/visualizar");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Falha ao atualizar usuário: {ex}");
            mensagem = ex is ArgumentException or InvalidOperationException
                ? ex.Message
                : "Não foi possível atualizar o usuário. Consulte os registros do servidor.";
        }
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}
