@page "/auditoria"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject IJSRuntime JS

<PageTitle>Auditoria do sistema</PageTitle>

<div class="centralizado">
    <div class="faixaNinja corSecundaria"><p>Auditoria do sistema</p></div>
    <p class="texto-padrao-1">
        Registro de alterações e entradas no sistema. Logins são registrados somente quando a autenticação é concluída com sucesso. Dados de senha, hashes e campos pessoais não são exibidos.
    </p>

    @if (registros.Count == 0)
    {
        <p>Nenhum registro de auditoria encontrado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr><th>Data/Hora (UTC)</th><th>Usuário</th><th>Entidade</th><th>ID</th><th>Operação</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in registros)
                    {
                        <tr>
                            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@item.Usuario</td>
                            <td>@item.Entidade</td>
                            <td>@(item.EntidadeId > 0 ? item.EntidadeId.ToString() : "-")</td>
                            <td>@item.Operacao</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <small>Exibindo até 300 registros mais recentes.</small>
    }

    <button type="button" class="btn btn-secondary mt-3" @onclick="Voltar">Voltar</button>
</div>

@code {
    private List<Auditoria> registros = new();

    protected override void OnInitialized()
    {
        registros = RepositorioTechToys.ListarAuditoria(300);
    }

    private async Task Voltar() => await JS.InvokeVoidAsync("history.back");
}
