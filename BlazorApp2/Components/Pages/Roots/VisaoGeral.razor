@page "/visao-geral"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "gerente, funcionario")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys
@inject NavigationManager Navigation

<PageTitle>Visão-Geral</PageTitle>

<h1 class="faixaNinja">Visão-Geral</h1>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
        @mensagem
    </div>
}

<div class="container-personalizado-2">
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('S')"> 
        <img class="foto-4" src="Media/vendas.png" alt="Icone-Estoque"/>
        <span class="texto-padrao-1">Estoque</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('I')">
        <img class="foto-4" src="Media/impressora.png" alt="Icone-Impressoras"/>
        <span class="texto-padrao-1">Impressoras</span>
        <span class="texto-padrao-1">@NumerarImpressoras() cadastrada(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('F')">
        <img class="foto-4" src="Media/fornecedor.png" alt="Icone-Fornecedores"/>
        <span class="texto-padrao-1">Fornecedores</span>
        <span class="texto-padrao-1">@NumerarFornecedores() cadastrado(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('M')">
        <img class="foto-4" src="Media/materiaprima.png" alt="Icone-Materia-Prima"/>
        <span class="texto-padrao-1">Materias-Primas</span>
        <span class="texto-padrao-1">@NumerarMateriasPrimas() cadastrada(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('P')">
        <img class="foto-4" src="Media/produtos2.png" alt="Icone-Produto"/>
        <span class="texto-padrao-1">Produtos</span>
        <span class="texto-padrao-1">@NumerarProdutos() cadastrado(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('C')">
        <img class="foto-4" src="Media/cliente.png" alt="Icone-Clientes"/>
        <span class="texto-padrao-1">Clientes</span>
        <span class="texto-padrao-1">@NumerarClientes() cadastrado(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('E')">
        <img class="foto-4" src="Media/embalagens.png" alt="Icone-Embalagens"/>
        <span class="texto-padrao-1">Embalagens</span>
        <span class="texto-padrao-1">@NumerarEmbalagens() cadastrada(s)!</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('V')">
        <img class="foto-4" src="Media/vendas.png" alt="Icone-Vendas"/>
        <span class="texto-padrao-1">Vendas</span>
        <span class="texto-padrao-1">@NumerarVendas() cadastrada(s)!</span>
    </div>

    <AuthorizeView Roles="gerente">
        <div class="card-personalizado-3" style="cursor: pointer;" @onclick="() => funcao('X')">
            <img class="foto-4" src="Media/fornecedor.png" alt="Icone-Funcionarios"/>
            <span class="texto-padrao-1">Funcionários</span>
        </div>
    
    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="CriarBanco">
        <img class="foto-2" src="Media/cadastrar.png" alt="Icone-Cadastrar"/>
        <span class="texto-padrao-1">Criar Banco</span>
    </div>

    <div class="card-personalizado-3" style="cursor: pointer;" @onclick="LimparBanco">
        <img class="foto-2" src="Media/deletar.png" alt="Icone-Deletar"/>
        <span class="texto-padrao-1">Limpar Banco</span>
    </div>
    </AuthorizeView>

</div>

<!-- Área exclusiva para o botão Voltar, logo abaixo do bloco de cards -->
<div class="area-botoes">
    <a class="btn btn-secondary" href="/">Voltar</a>
</div>

@code {
    private string mensagem = string.Empty;
    private bool sucesso = true;
    
    private int numeroImpressoras = 0;
    List<Impressora> impressoras = new List<Impressora>();

    public int NumerarImpressoras()
    {
        impressoras = RepositorioTechToys.ListarTodos<Impressora>();
        numeroImpressoras = impressoras.Count();
        return numeroImpressoras;
    }

    public int NumerarClientes()
    {
        List<Cliente> clientes = RepositorioTechToys.ListarTodos<Cliente>();
        return clientes.Count();
    }

    public int NumerarEmbalagens()
    {
        List<Embalagem> embalagens = RepositorioTechToys.ListarTodos<Embalagem>();
        return embalagens.Count();
    }

    public int NumerarFornecedores()
    {
        List<Fornecedor> fornecedores = RepositorioTechToys.ListarTodos<Fornecedor>();
        return fornecedores.Count();
    }

    public int NumerarMateriasPrimas()
    {
        List<MateriaPrima> materiasPrimas = RepositorioTechToys.ListarTodos<MateriaPrima>();
        return materiasPrimas.Count();
    }

    public int NumerarProdutos()
    {
        var produtos = RepositorioTechToys.ListarTodos<TechToysDominio.Produto>();
        return produtos.Count();
    }

    public int NumerarVendas()
    {
        List<Venda> vendas = RepositorioTechToys.ListarTodos<Venda>();
        return vendas.Count();
    }

    private void CriarBanco()
    {
        try
        {
            RepositorioTechToys.CriarBanco();
            
            sucesso = true;
            mensagem = "Banco de dados e tabelas criados com sucesso!";
            
            RepositorioTechToys.CadastrarUsuario(
                "admin",
                "senha",
                "gerente"
            );
            
            RepositorioTechToys.CadastrarUsuario(
                "funcionario",
                "senha",
                "funcionario"
            );

            RepositorioTechToys.CadastrarImpressora("nenhuma", "", 0);
            RepositorioTechToys.CadastrarFornecedor("nenhum", "", "", "");
            RepositorioTechToys.CadastrarCliente("nenhum", "", "", "");

            RepositorioTechToys.CadastrarMateriaPrima(
                "nenhuma",
                0,
                0,
                RepositorioTechToys.ObterPorId<Fornecedor>(1),
                0
            );

            RepositorioTechToys.CadastrarProduto(
                "nenhum",
                RepositorioTechToys.ObterPorId<MateriaPrima>(1),
                RepositorioTechToys.ObterPorId<Impressora>(1),
                0,
                0,
                0,
                0,
                0,
                0,
                0
            );

            RepositorioTechToys.CadastrarEmbalagem(
                "nenhuma",
                "",
                0,
                0,
                0,
                0,
                RepositorioTechToys.ObterPorId<Fornecedor>(1),
                0
            );
        }
        catch (Exception ex)
        {
            sucesso = false;
            mensagem = $"Erro ao criar banco: {ex.Message}";
        }
    }

    private void LimparBanco()
    {
        Navigation.NavigateTo("visao-geral/limpar-banco/");
    }

    private void funcao(char c)
    {
        if (c == 'C')
        {
            Navigation.NavigateTo("clientes/visualizar/");
        }

        if (c == 'E')
        {
            Navigation.NavigateTo("embalagens/visualizar/");
        }

        if (c == 'F')
        {
            Navigation.NavigateTo("fornecedores/visualizar/");
        }

        if (c == 'I')
        {
            Navigation.NavigateTo("impressoras/visualizar/");
        }

        if (c == 'M')
        {
            Navigation.NavigateTo("materias-primas/visualizar/");
        }

        if (c == 'P')
        {
            Navigation.NavigateTo("produtos/visualizar/");
        }

        if (c == 'V')
        {
            Navigation.NavigateTo("vendas/visualizar/");
        }
        
        if (c == 'X')
        {
            Navigation.NavigateTo("funcionarios/visualizar/");
        }
        
        if (c == 'S')
        {
            Navigation.NavigateTo("estoque/visualizar/");
        }
    }
}