@page "/materias-primas"
@rendermode InteractiveServer

@using TechToysDominio
@using Repositorio
@inject RepositorioTechToys RepositorioTechToys

<PageTitle>Matérias-Primas</PageTitle>

<h1 class="faixaNinja">Matérias-Primas</h1>

<div class="sera">
    <!-- Grid com os cards -->
    <div class="container-personalizado-2">
        <div class="card-personalizado-2">
            <a href="materias-primas/cadastrar"><img class="foto-2" src="Media/cadastrar.png" alt="Icone-Cadastrar"/></a>
            <a class="texto-padrao-1" href="materias-primas/cadastrar">Cadastrar</a>
        </div>
        <div class="card-personalizado-2">
            <a href="materias-primas/visualizar"><img class="foto-2" src="Media/visualizar.png" alt="Icone-Visualizar"/></a>
            <a class="texto-padrao-1" href="materias-primas/visualizar">Visualizar</a>
        </div>
        <div class="card-personalizado-2">
            <a href="materias-primas/editar"><img class="foto-2" src="Media/editar.png" alt="Icone-Editar"/></a>
            <a class="texto-padrao-1" href="materias-primas/editar">Editar</a>
        </div>
        <div class="card-personalizado-2">
            <a href="materias-primas/deletar"><img class="foto-2" src="Media/deletar.png" alt="Icone-Deletar"/></a>
            <a class="texto-padrao-1" href="materias-primas/deletar">Deletar</a>
        </div>
    </div>

    <!-- Área exclusiva para o botão Voltar, logo abaixo do bloco de cards -->
    <div class="area-botoes">
        <a class="btn btn-secondary" href="/" alt="Voltar">Voltar</a>
    </div>
</div>