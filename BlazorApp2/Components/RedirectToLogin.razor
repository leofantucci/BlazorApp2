@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var caminhoOriginal = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var destino = $"/login?returnUrl={Uri.EscapeDataString(caminhoOriginal)}";
        Navigation.NavigateTo(destino, forceLoad: true, replace: true);
    }
}
