# Copie para .env e preencha localmente. Nunca envie .env ao Git.
DATABASE_URL="Host=SEU_HOST;Port=5432;Database=neondb;Username=SEU_USUARIO;Password=SUA_SENHA;SSL Mode=Require"

# Preencha SOMENTE se o banco estiver vazio e precisar criar o primeiro administrador.
BOOTSTRAP_ADMIN_LOGIN=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Opcional em hospedagem atrás de proxy reverso. Informe APENAS IPs fixos/confiáveis,
# separados por vírgula. Não use 0.0.0.0/0 nem IPs enviados por clientes.
# TRUSTED_PROXY_IPS="127.0.0.1,10.0.0.10"
